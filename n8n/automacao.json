    {
      "parameters": {
        "jsCode": "const equipamentos = $input.all();\nreturn equipamentos.map(item => {\n    const dados = item.json;\n    const partes = dados.data_ultima_manutencao.split(\"/\");\n    const ultimaManutencao = new Date(\n        Date.UTC(\n            Number(partes[2]),\n            Number(partes[1]) - 1,\n            Number(partes[0])\n        )\n    );\n    const hoje = new Date();\nconsole.log(hoje.toString());\n\nconst hojeUTC = Date.UTC(\n    hoje.getFullYear(),\n    hoje.getMonth(),\n    hoje.getDate()\n);\n    const proximaManutencao = new Date(\n        ultimaManutencao.getTime() +\n        Number(dados.intervalo_dias) * 86400000\n    );\n    const diasRestantes = Math.round(\n        (proximaManutencao.getTime() - hojeUTC) /\n        86400000\n    );\n    return {\n        json: {\n            ...dados,\n            dias_restantes: diasRestantes\n        }\n    };\n});"
      },
